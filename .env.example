# Bí mật ký cookie phiên. Bắt buộc, tối thiểu 32 ký tự.
#   openssl rand -base64 48
LNHDESIGN_SESSION_SECRET=

# Tài khoản nội bộ, dạng `email:hash`, nhiều tài khoản ngăn bằng dấu phẩy.
# Sinh hash bằng: node scripts/hash-password.mjs <email> <password>
#
# Hash phân cách bằng DẤU CHẤM (pbkdf2.210000.<salt>.<hash>), không phải `$`.
# Trình nạp .env của Next expand `$xxx` thành chuỗi rỗng — hash bị cắt cụt và
# mọi lần đăng nhập đều trả 401 mà không có dấu hiệu gì.
LNHDESIGN_USERS=

# Token cho registry riêng (`/r/internal/*.json`). Repo dùng đặt cùng giá trị
# này vào env của họ rồi khai trong components.json.
#   openssl rand -hex 32
LNHDESIGN_TOKEN=

# Domain ghi vào `homepage` của registry.json lúc build.
LNHDESIGN_HOMEPAGE=https://lnhdesign.vercel.app

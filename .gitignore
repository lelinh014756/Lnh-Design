# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Mẫu biến môi trường phải commit — nó không chứa giá trị thật.
!.env.example

# Sinh bởi registry-builder ở mỗi lần build.
public/r/
registry.json
registry.internal.json

# demo source trích lúc build (pnpm demos:build)
/src/modules/showcase/demos/generated/

worktree/
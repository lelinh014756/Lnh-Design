# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager
package-lock.json
yarn.lock

# env files (can opt-in for committing if needed)
.env*
# Mẫu biến môi trường phải commit — nó không chứa giá trị thật.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sinh bởi registry-builder ở mỗi lần build.
public/r/
registry.json
registry.internal.json

# demo source trích lúc build (pnpm demos:build)
/src/modules/showcase/demos/generated/

# turbo cache và log build
.turbo/

repomix-output.xml
ai-context.md
.serena/cache
plans/**/*
!plans/templates/*
screenshots/*
docs/screenshots/*
docs_local
logs.txt
test-ck
__pycache__

# CK meta commands
prompt.md
ck.md

# Local-only state inside tracked claude source
.claude/settings.local.json
.claude/memory/
.claude/skills/.venv/
.claude/skills/node_modules/
.claude/teams/
.claude/hooks/.logs/
.claude/chrome-devtools/
.claude/session-state/

# Gemini CLI settings (symlink to staged .claude/.mcp.json)
.gemini/settings.json
# External repos for study/reference
external/

# Git worktrees (local development only)
worktree/
worktrees/

# Bản sao skill tạm (không commit)
/.claude/skills copy/

# Generated OpenCode backup from scripts/generate-opencode.py --force
.opencode.backup/